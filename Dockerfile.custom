# ================================================================
# 🧱 STEP 1 — INSTALL BUN (v1.2.23 to match your local environment)
# ================================================================
ARG BUN_VERSION=1.2.23
FROM debian:bullseye-slim AS build-bun
ARG BUN_VERSION

RUN apt-get update -qq \
  && apt-get install -qq --no-install-recommends \
    ca-certificates curl unzip \
  && rm -rf /var/lib/apt/lists/* \
  && arch="$(dpkg --print-architecture)" \
  && case "${arch##*-}" in \
      amd64) build="x64-baseline" ;; \
      arm64) build="aarch64" ;; \
      *) echo "error: unsupported architecture: $arch"; exit 1 ;; \
     esac \
  && tag="bun-v${BUN_VERSION}" \
  && curl -fsSL --retry 5 \
     "https://github.com/oven-sh/bun/releases/download/${tag}/bun-linux-${build}.zip" -o bun.zip \
  && unzip bun.zip -d /usr/local/bin/ \
  && mv /usr/local/bin/bun-linux-${build}/bun /usr/local/bin/bun \
  && chmod +x /usr/local/bin/bun \
  && rm -rf bun.zip /usr/local/bin/bun-linux-${build} \
  && bun --version

# ================================================================
# # 🧰 STEP 2 — BASE IMAGE (Node 18 + Bun)
# # ================================================================
# FROM node:18-bullseye-slim AS base
# 🧰 STEP 2 — BASE IMAGE (Node 22 + Bun)
# ================================================================
FROM node:22-bullseye-slim AS base
ENV NODE_ENV=production
ENV BUN_INSTALL_BIN=/usr/local/bin
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0

COPY --from=build-bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx \
  && groupadd -r bun && useradd -r -g bun bun \
  && apt-get update -qq \
  && apt-get install -qq --no-install-recommends git openssl python3 g++ build-essential \
  && rm -rf /var/lib/apt/lists/* \
  && bun --version \
  && node --version

WORKDIR /app

# ================================================================
# 🚀 STEP 3 — TURBO REPOSITORY PRUNE (optional)
# ================================================================
FROM base AS pruned
ARG SCOPE

WORKDIR /app
COPY . .

# --- Choose database type for Prisma ---
ARG DATABASE_PROVIDER=postgresql
ENV DATABASE_PROVIDER=${DATABASE_PROVIDER}

RUN if [ "$DATABASE_PROVIDER" = "mysql" ]; then \
      echo "📦 Using MySQL Prisma schema"; \
      cp packages/prisma/mysql/schema.prisma packages/prisma/schema.prisma; \
    else \
      echo "🐘 Using PostgreSQL Prisma schema"; \
      cp packages/prisma/postgresql/schema.prisma packages/prisma/schema.prisma; \
    fi

RUN bunx turbo@2.4.5-canary.7 prune "${SCOPE}" --docker

# ================================================================
# ⚙️ STEP 4 — INSTALL & BUILD (Next 15 + Bun)
# ================================================================
FROM base AS builder
ARG SCOPE
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_ENV_CHECK=true
ENV NODE_ENV=production

# Copy pruned app for faster builds
COPY --from=pruned /app/out/full/ .

# Force lockfile usage to avoid mismatched dependency resolution
RUN SENTRYCLI_SKIP_DOWNLOAD=1 bun install --frozen-lockfile
RUN SKIP_ENV_CHECK=true bunx turbo build --filter="${SCOPE}"

# ================================================================
# 🧩 STEP 5 — RELEASE IMAGE
# ================================================================
FROM base AS release
ARG SCOPE
ENV SCOPE=${SCOPE}
ENV NODE_ENV=production

# Copy necessary build artifacts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/${SCOPE}/.next/standalone ./
COPY --from=builder /app/apps/${SCOPE}/.next/static ./apps/${SCOPE}/.next/static
COPY --from=builder /app/apps/${SCOPE}/public ./apps/${SCOPE}/public

# COPY Prisma schema from pruned stage
COPY --from=pruned /app/packages/prisma ./packages/prisma

RUN bunx prisma generate --schema=packages/prisma/schema.prisma

# Entrypoint
COPY scripts/entrypoint.sh ./
RUN chmod +x ./entrypoint.sh
ENTRYPOINT ["./entrypoint.sh"]

EXPOSE 3000
ENV PORT=3000
